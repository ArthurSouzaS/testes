<div class="a11y" role="group" aria-label="Acessibilidade">
  <button type="button" class="a11y-btn" data-fonte="-1" title="Diminuir fonte" aria-label="Diminuir tamanho da fonte">A−</button>
  <button type="button" class="a11y-btn" data-fonte="1" title="Aumentar fonte" aria-label="Aumentar tamanho da fonte">A+</button>
  <button type="button" class="a11y-btn" data-alternar="tema" title="Tema claro/escuro" aria-label="Alternar tema claro ou escuro"><%- include('icone', {nome:'lua'}) %></button>
  <button type="button" class="a11y-btn" data-alternar="daltonico" title="Modo para daltônicos" aria-label="Alternar cores para daltônicos"><%- include('icone', {nome:'olho'}) %></button>
</div>
